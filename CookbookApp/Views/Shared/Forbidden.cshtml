@{
	ViewData["Title"] = "Access Denied";
	bool isSignedIn = User.Identity?.IsAuthenticated == true;
}

<section class="bg-light rounded-3 px-4 py-5 p-md-5 my-4" aria-labelledby="error-title">
	<div class="row justify-content-center">
		<div class="col-lg-10 col-xl-8 text-center">
			<p class="text-success fw-bold text-uppercase small mb-3">
				Your everyday kitchen companion
			</p>

			<p class="display-1 fw-bold text-success mb-3">403 Forbidden</p>

			<h1 id="error-title" class="display-5 fw-bold mb-4">
				You don't have permission to access this page.
			</h1>

			<br />

			<div class="d-grid gap-3 d-sm-flex justify-content-sm-center">
				<a asp-controller="Home"
				asp-action="Index"
				class="btn btn-success btn-lg px-4">
					Back to Home
				</a>

				@if(isSignedIn)
				{
					<a asp-controller="Recipes"
					asp-action="MyRecipes"
					class="btn btn-outline-success btn-lg px-4">
						My Recipes
					</a>
				}
				else
				{
					<a asp-area="Identity"
					asp-page="/Account/Login"
					class="btn btn-outline-success btn-lg px-4">
						Sign In
					</a>
				}
			</div>
		</div>
	</div>
</section>
