@model AddRecipeInputModel

@{
    ViewData["Title"] = "Add Recipe";
}

<section class="py-4" aria-labelledby="add-recipe-title">
    <header class="bg-light rounded-3 p-4 p-md-5 mb-4">
        <p class="text-success fw-bold text-uppercase small mb-2">
            A new page in your cookbook
        </p>

        <h1 id="add-recipe-title" class="display-5 fw-bold mb-3">
            Add Recipe
        </h1>
    </header>

    <form asp-controller="Recipes"
          asp-action="Add"
          method="post">
        <div asp-validation-summary="All"
             class="text-danger mb-4"
             role="alert">
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <section class="card border shadow-sm mb-4"
                         aria-labelledby="basics-title">
                    <div class="card-body p-4">
                        <p class="small fw-bold text-success mb-2">
                            01 / THE BASICS
                        </p>

                        <h2 id="basics-title" class="h4 mb-4">
                            Give your recipe a name and a category
                        </h2>

                        <div class="mb-4">
                            <label asp-for="Title"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="For example, Grandma's apple pie" />

                            <span asp-validation-for="Title"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                   Category
                            </label>

                            <select asp-for="CategoryId"
                                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(
                                        Model.Categories, "Id", "Name"))"
                                    class="form-select">
                                <option value="">Choose a category</option>
                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div>
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <span class="small text-muted ms-1">
                                Optional
                            </span>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Add a short introduction, a family memory, or a serving suggestion."
                                      aria-describedby="description-help"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>
                        </div>
                    </div>
                </section>

                <section class="card border shadow-sm mb-4"
                         aria-labelledby="ingredients-title">
                    <div class="card-body p-4">
                        <p class="small fw-bold text-success mb-2">
                            02 / THE INGREDIENTS
                        </p>

                        <h2 id="ingredients-title" class="h4 mb-3">
                            What goes into it?
                        </h2>

                        <p id="ingredients-help" class="text-muted">
                            Enter one ingredient per line. Separate the
                            name and quantity with a vertical bar
                            (<strong>|</strong>).
                        </p>

                        <div class="bg-light border rounded-3 p-3 mb-4">
                            <p class="small fw-semibold mb-2">
                                Example
                            </p>

                            <pre class="small mb-0"> 200 g | Flour</pre>
                        </div>

                        <label asp-for="IngredientsText"
                               class="form-label fw-semibold">
                               Ingredients
                        </label>

                        <textarea asp-for="IngredientsText"
                                  class="form-control"
                                  rows="8"
                                  placeholder="Quantity | Ingredient name"
                                  aria-describedby="ingredients-help ingredients-tip"></textarea>

                        <div id="ingredients-tip" class="form-text">
                            Add as many lines as you need. Include units
                            such as g, ml, cups, or tablespoons.
                        </div>

                        <span asp-validation-for="IngredientsText"
                              class="text-danger small">
                        </span>
                    </div>
                </section>

                <section class="card border shadow-sm"
                         aria-labelledby="method-title">
                    <div class="card-body p-4">
                        <p class="small fw-bold text-success mb-2">
                            03 / THE METHOD
                        </p>

                        <h2 id="method-title" class="h4 mb-3">
                            Bring it all together
                        </h2>

                        <p id="instructions-help" class="text-muted">
                            Describe the preparation and cooking steps.
                            Mark each step with asterisk (*)
                        </p>

                        <label asp-for="Instructions"
                               class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Instructions"
                                  class="form-control"
                                  rows="10"
                                  placeholder="* Prepare your ingredients..."
                                  aria-describedby="instructions-help instructions-tip"></textarea>

                        <span asp-validation-for="Instructions"
                              class="text-danger small">
                        </span>
                    </div>
                </section>
            </div>

            <aside class="col-lg-4">
                <section class="card border shadow-sm mb-4"
                         aria-labelledby="photo-title">
                    <div class="card-body p-4">
                        <h2 id="photo-title" class="h4 mb-3">
                            A picture of your dish
                        </h2>

                        <p class="text-muted small">
                            Give your recipe a familiar face with
                            a photo of the finished dish.
                        </p>

                        <label asp-for="ImageUrl"
                               class="form-label fw-semibold">
                        </label>

                        <span class="small text-muted ms-1">
                            Optional
                        </span>

                        <input asp-for="ImageUrl"
                               type="url"
                               class="form-control"
                               placeholder="https://example.com/dish.jpg"
                               aria-describedby="image-help" />

                        <div id="image-help" class="form-text">
                            Enter a direct HTTPS link to an image.
                            This is not a file upload.
                        </div>

                        <span asp-validation-for="ImageUrl"
                              class="text-danger small">
                        </span>
                    </div>
                </section>

                <section class="bg-light border rounded-3 p-4"
                         aria-labelledby="tips-title">
                    <h2 id="tips-title" class="h5 text-success mb-3">
                        A recipe worth keeping
                    </h2>

                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-2">
                            Use a clear, descriptive title.
                        </li>
                        <li class="mb-2">
                            Include a quantity for every ingredient.
                        </li>
                        <li>
                            Write the steps in the order you would cook them.
                        </li>
                    </ul>
                </section>
            </aside>
        </div>

        <div class="border-top mt-4 pt-4">
            <div class="row align-items-center g-3">
                <div class="col-md-5">
                    <div class="d-grid gap-2 d-sm-flex justify-content-md-start">
                        <a asp-controller="Recipes"
                           asp-action="MyRecipes"
                           class="btn btn-outline-secondary px-4">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-success px-4">
                            Save Recipe
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</section>


