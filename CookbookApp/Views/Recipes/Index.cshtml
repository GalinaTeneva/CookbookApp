@model CookbookOverviewViewModel

@{
    ViewData["Title"] = "My Cookbook";
    var categories = Model.Categories.ToArray();
}

<section class="py-4" aria-labelledby="cookbook-title">
    <header class="bg-light rounded-3 p-4 p-md-5 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <p class="text-success fw-bold text-uppercase small mb-2">
                    Your personal cookbook
                </p>

                <h1 id="cookbook-title" class="display-5 fw-bold mb-3">
                    My Cookbook
                </h1>

                <p class="text-muted mb-0">
                    A little overview of what is cooking in your collection.
                </p>
            </div>

            <div class="col-md-4">
                <div class="d-grid d-md-flex justify-content-md-end">
                    <a asp-controller="Recipes"
                       asp-action="Add"
                       class="btn btn-success btn-lg">
                        Add Recipe
                    </a>
                </div>
            </div>
        </div>
    </header>

    @if (Model.TotalRecipes == 0)
    {
        <div class="border rounded-3 text-center p-4 p-md-5">
            <h2 class="h1 mb-3">Your cookbook starts here.</h2>

            <p class="text-muted mb-4">
                Add your first recipe to start building your collection.
            </p>

            <a asp-controller="Recipes"
               asp-action="Add"
               class="btn btn-success btn-lg">
                Add Your First Recipe
            </a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-sm-6">
                <div class="border rounded-3 p-4 h-100">
                    <h2 class="h6 text-muted">Recipes in your cookbook</h2>
                    <p class="display-5 fw-bold text-success mb-0">
                        @Model.TotalRecipes
                    </p>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="border rounded-3 p-4 h-100">
                    <h2 class="h6 text-muted">Categories explored</h2>
                    <p class="display-5 fw-bold text-success mb-0">
                        @categories.Length
                    </p>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <section class="card h-100 shadow-sm"
                         aria-labelledby="categories-title">
                    <div class="card-body p-4">
                        <h2 id="categories-title" class="h4 mb-3">
                            Your Cookbook by Category
                        </h2>

                        <p class="text-muted">
                            See how your collection is coming together.
                        </p>

                        <ul class="list-group list-group-flush">
                            @foreach (var category in categories)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center gap-3 px-0 py-3">
                                    <span class="fw-semibold text-break">
                                        @category.CategoryName
                                    </span>

                                    <span class="badge rounded-pill bg-success">
                                        @category.RecipeCount
                                        @(category.RecipeCount == 1 ? "recipe" : "recipes")
                                    </span>
                                </li>
                            }
                        </ul>

                        <a asp-controller="Recipes"
                           asp-action="MyRecipes"
                           class="btn btn-outline-success mt-4">
                            Browse All My Recipes
                        </a>
                    </div>
                </section>
            </div>

            <div class="col-lg-5">
                @if (Model.LatestRecipe is { } latestRecipe)
                {
                    <section class="card h-100 shadow-sm"
                             aria-labelledby="latest-recipe-title">
                        <div class="card-body d-flex flex-column p-4">
                            <p class="text-success fw-bold text-uppercase small mb-2">
                                Freshly added
                            </p>

                            <h2 id="latest-recipe-title" class="h4 mb-3">
                                Your Latest Recipe
                            </h2>

                            <div class="mb-3">
                                <span class="badge rounded-pill bg-light text-success border">
                                    @latestRecipe.CategoryName
                                </span>
                            </div>

                            <h3 class="h3 text-break mb-3">
                                @latestRecipe.Title
                            </h3>

                            <p class="text-muted mb-4">
                                Added on @latestRecipe.CreatedOn
                            </p>

                            <div class="mt-auto">
                                <a asp-controller="Recipes"
                                   asp-action="Details"
                                   asp-route-id="@latestRecipe.Id"
                                   class="btn btn-success w-100">
                                    View Recipe
                                </a>
                            </div>
                        </div>
                    </section>
                }
            </div>
        </div>
    }
</section>

