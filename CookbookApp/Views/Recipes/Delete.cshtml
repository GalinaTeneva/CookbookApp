@model DeleteRecipeViewModel

@{
    ViewData["Title"] = "Delete Recipe";
}

<section class="py-4" aria-labelledby="delete-recipe-title">
    <header class="bg-light rounded-3 p-4 p-md-5 mb-4">
        <p class="text-success fw-bold text-uppercase small mb-2">
            Manage your cookbook
        </p>

        <h1 id="delete-recipe-title" class="display-5 fw-bold mb-3">
            Delete Recipe
        </h1>

        <p class="text-muted mb-0">
            Review your choice before removing this recipe from your cookbook.
        </p>
    </header>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="card border shadow-sm"
                     aria-labelledby="delete-confirmation-title">
                <div class="card-body p-4 p-md-5">
                    <h2 id="delete-confirmation-title" class="h4 mb-3">
                        Delete &ldquo;@Model.Title&rdquo;?
                    </h2>

                    <p class="text-muted">
                        This will permanently remove the recipe, including
                        its instructions and ingredient list.
                    </p>

                    <div class="alert alert-warning" role="note">
                        This action cannot be undone.
                    </div>

                    <form asp-controller="Recipes"
                          asp-action="Delete"
                          asp-route-id="@Model.Id"
                          method="post">
                        <div asp-validation-summary="All"
                             class="text-danger mb-3"
                             role="alert">
                        </div>

                        <div class="border-top mt-4 pt-4">
                            <div class="d-grid gap-2 d-sm-flex">
                                <a asp-controller="Recipes"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-outline-secondary px-4">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-danger px-4">
                                    Delete Recipe
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </div>
</section>

