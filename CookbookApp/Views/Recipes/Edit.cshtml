@model EditRecipeInputModel

@{
    ViewData["Title"] = "Edit Recipe";
}

<section class="py-4" aria-labelledby="edit-recipe-title">
    <header class="bg-light rounded-3 p-4 p-md-5 mb-4">
        <p class="text-success fw-bold text-uppercase small mb-2">
            Refine a page in your cookbook
        </p>

        <h1 id="edit-recipe-title" class="display-5 fw-bold mb-3">
            Edit Recipe
        </h1>

        <p class="text-muted mb-0">
            Update your recipe details, ingredients, or cooking instructions.
        </p>
    </header>

    <form asp-controller="Recipes"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">
        <partial name="_RecipeForm" model="Model" />

        <div class="border-top mt-4 pt-4">
            <div class="d-grid gap-2 d-sm-flex">
                <a asp-controller="Recipes"
                   asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary px-4">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success px-4">
                    Save Changes
                </button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
